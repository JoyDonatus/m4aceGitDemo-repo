//Create custom error classes, 
// implement centralized error handling middleware, 
// and return consistent error responses

const express = require('express');
const app = express();
const PORT = 3000;

app.use(express.json());

class AppError extends Error {
    constructor(message, statusCode) {
        super(message); 
        this.statusCode = statusCode;
        this.status = `${statusCode}`.startsWith('4') ? 'fail' : 'error';
        this.isOperational = true; 

        Error.captureStackTrace(this, this.constructor);
    }
}

//Error for Bad Input (400)
class BadRequestError extends AppError {
    constructor(message = "Bad Request") {
        super(message, 400);
    }
}

// Specific Error for Resources Not Found (404)
class NotFoundError extends AppError {
    constructor(message = "Resource not found") {
        super(message, 404);
    }
}

app.get('/api/users/:id', (req, res, next) => {
    const userId = req.params.id;
    
    if (userId !== "1") {
        return next(new NotFoundError(`User with ID ${userId} does not exist.`));
    }
    
    res.status(200).json({ status: "success", data: { user: "Joy" } });
});

app.post('/api/posts', (req, res, next) => {
    const { title } = req.body;

    if (!title) {
        return next(new BadRequestError("Please provide a title for your blog post."));
    }

    res.status(201).json({ status: "success", message: "Post created!" });
});

app.get('/api/crash-test', (req, res, next) => {
    try {
        undefinedFunction(); 
    } catch (err) {
        next(err);
    }
});


app.use((err, req, res, next) => {

    err.statusCode = err.statusCode || 500;
    err.status = err.status || 'error';

    const errorResponse = {
        status: err.status,
        statusCode: err.statusCode,
        message: err.message
    };

    if (!err.isOperational) {
        console.error("CRITICAL SYSTEM CRASH LOG:", err);
        errorResponse.message = "Something went completely wrong on our servers.";
    }

    res.status(err.statusCode).json(errorResponse);
});

app.listen(PORT, () => {
    console.log(`Error handling center running on http://localhost:${PORT}`);
});